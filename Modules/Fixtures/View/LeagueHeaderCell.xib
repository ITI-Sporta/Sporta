<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="13142" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="12042"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <collectionViewCell opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" id="headerCellRoot" customClass="LeagueHeaderCell" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="414" height="120"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <view key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" id="headerContentView">
                <rect key="frame" x="0.0" y="0.0" width="414" height="120"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="headerCardBG">
                        <rect key="frame" x="0" y="8" width="414" height="104"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <userDefinedRuntimeAttributes>
                            <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                                <integer key="value" value="12"/>
                            </userDefinedRuntimeAttribute>
                        </userDefinedRuntimeAttributes>
                        <subviews>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" translatesAutoresizingMaskIntoConstraints="NO" id="leagueImg">
                                <rect key="frame" x="12" y="12" width="80" height="80"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="80" id="imgW"/>
                                    <constraint firstAttribute="height" constant="80" id="imgH"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" text="League Name" translatesAutoresizingMaskIntoConstraints="NO" id="leagueName">
                                <rect key="frame" x="108" y="24" width="290" height="26"/>
                                <fontDescription key="fontDescription" type="boldSystem" pointSize="22"/>
                                <color key="textColor" red="0.078" green="0.156" blue="0.313" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" text="Country" translatesAutoresizingMaskIntoConstraints="NO" id="countrySeason">
                                <rect key="frame" x="108" y="54" width="290" height="20"/>
                                <fontDescription key="fontDescription" type="system" weight="medium" pointSize="16"/>
                                <color key="textColor" systemColor="secondaryLabelColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <constraints>
                            <constraint firstItem="leagueImg" firstAttribute="leading" secondItem="headerCardBG" secondAttribute="leading" constant="12" id="imgLead"/>
                            <constraint firstItem="leagueImg" firstAttribute="centerY" secondItem="headerCardBG" secondAttribute="centerY" id="imgCY"/>
                            <constraint firstItem="leagueName" firstAttribute="leading" secondItem="leagueImg" secondAttribute="trailing" constant="16" id="nameLead"/>
                            <constraint firstItem="leagueName" firstAttribute="top" secondItem="headerCardBG" secondAttribute="top" constant="24" id="nameTop"/>
                            <constraint firstItem="headerCardBG" firstAttribute="trailing" secondItem="leagueName" secondAttribute="trailing" constant="12" id="nameTrail"/>
                            <constraint firstItem="countrySeason" firstAttribute="leading" secondItem="leagueName" secondAttribute="leading" id="countryLead"/>
                            <constraint firstItem="countrySeason" firstAttribute="top" secondItem="leagueName" secondAttribute="bottom" constant="4" id="countryTop"/>
                        </constraints>
                    </view>
                </subviews>
                <color key="backgroundColor" white="0" alpha="0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                <constraints>
                    <constraint firstItem="headerCardBG" firstAttribute="top" secondItem="headerContentView" secondAttribute="top" constant="8" id="cardTop"/>
                    <constraint firstItem="headerCardBG" firstAttribute="leading" secondItem="headerContentView" secondAttribute="leading" id="cardLead"/>
                    <constraint firstItem="headerContentView" firstAttribute="trailing" secondItem="headerCardBG" secondAttribute="trailing" id="cardTrail"/>
                    <constraint firstItem="headerContentView" firstAttribute="bottom" secondItem="headerCardBG" secondAttribute="bottom" constant="8" id="cardBot"/>
                </constraints>
            </view>
            <connections>
                <outlet property="leagueImageView" destination="leagueImg" id="imgOutlet"/>
                <outlet property="leagueNameLabel" destination="leagueName" id="nameOutlet"/>
                <outlet property="countrySeasonLabel" destination="countrySeason" id="countryOutlet"/>
            </connections>
        </collectionViewCell>
    </objects>
</document>
 
